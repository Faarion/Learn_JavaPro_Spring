CREATE TABLE Citizen(
	citizen_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
	name VARCHAR(100) NOT NULL,
	age INT CHECK(age > 0)
);

CREATE TABLE Passport(
	citizen_id INT PRIMARY KEY REFERENCES Citizen(citizen_id),
	passport_number INT
);
 
